PORT=8787
UPSTREAM_BASE_URL=https://your-relay.example.com
UPSTREAM_API_KEY=sk-your-upstream-key
# Optional. If set, clients must call this router with Authorization: Bearer <ROUTER_API_KEY>.
ROUTER_API_KEY=
